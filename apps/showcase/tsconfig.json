{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@eds/website-components": ["../../packages/components/src/index.ts"],
      "@eds/website-components/*": ["../../packages/components/src/*"],
      "@eds/website-animations": ["../../packages/animations/src/index.ts"],
      "@eds/website-animations/*": ["../../packages/animations/src/*"],
      "@eds/website-tokens": ["../../packages/tokens"],
      "@eds/website-tokens/*": ["../../packages/tokens/*"]
    },
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
