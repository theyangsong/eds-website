{
  "$description": "Motion Base — primitive only（duration / easing / opacity / scale / offset）。引用：@eds/website-tokens/motion/base",
  "groups": [
    {
      "comment": "Duration（时长阶梯 · --eds-motion-N）",
      "tokens": {
        "eds-motion-0": "0ms",
        "eds-motion-1": "100ms",
        "eds-motion-2": "150ms",
        "eds-motion-3": "200ms",
        "eds-motion-4": "300ms",
        "eds-motion-5": "600ms",
        "eds-motion-6": "500ms",
        "eds-motion-7": "700ms",
        "eds-motion-8": "250ms",
        "eds-motion-9": "350ms",
        "eds-motion-10": "800ms",
        "eds-motion-11": "2000ms",
        "eds-motion-12": "180ms"
      },
      "usageNotes": [
        "0 = instant / focus / reduced-motion",
        "4 = 默认 hover（300ms）",
        "8 = Toggle / Tab 滑块（250ms）",
        "12 = Layout Deform 内容 crossfade",
        "10–11 = Spinner 周期"
      ]
    },
    {
      "comment": "Easing（缓动曲线 · --eds-motion-ease-N）",
      "tokens": {
        "eds-motion-ease-1": "ease-in-out",
        "eds-motion-ease-2": "cubic-bezier(0.2, 0, 0, 1)",
        "eds-motion-ease-3": "cubic-bezier(0.4, 0, 1, 1)",
        "eds-motion-ease-4": "cubic-bezier(0.4, 0, 0.2, 1)",
        "eds-motion-ease-5": "linear",
        "eds-motion-ease-6": "cubic-bezier(0.34, 1.4, 0.64, 1)",
        "eds-motion-ease-7": "cubic-bezier(0.34, 1.45, 0.64, 1)",
        "eds-motion-ease-8": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "usageNotes": [
        "ease-1 = 缓入缓出（对称 hover，默认）",
        "ease-4 = Material · ease-5 = 线性（Spinner）",
        "ease-6/7 = 弹性反馈 · ease-8 = 减速渐隐"
      ]
    },
    {
      "comment": "Primitive State（物理量 — 无场景语义）",
      "tokenList": [
        { "name": "motion-opacity-hidden", "value": "0" },
        { "name": "motion-opacity-visible", "value": "1" },
        { "name": "motion-scale-small", "value": "0.95" },
        { "name": "motion-scale-flotation-enter", "value": "0.96", "comment": "Flotation 入场 scale" },
        { "name": "motion-offset-small", "value": "var(--spacing-2)", "comment": "8px · shift" },
        { "name": "motion-offset-nudge-y", "value": "calc(-1 * var(--spacing-1-5))", "comment": "-6px · nudge（legacy）" },
        { "name": "motion-offset-flotation-y", "value": "calc(-1 * var(--spacing-2-5))", "comment": "-10px · Flotation 入场" },
        { "name": "motion-offset-page-push", "value": "30%", "comment": "页面推动位移（相对容器宽度）" },
        { "name": "motion-offset-layout-deform-y", "value": "var(--spacing-2-5)", "comment": "10px · Layout Deform 内容 vertical nudge（Popover crossfade）" }
      ]
    },
    {
      "comment": "Website component aliases（@eds/website-components 沿用）",
      "tokenList": [
        { "name": "eds-motion-hover-duration", "value": "var(--eds-motion-9)", "comment": "350ms" },
        { "name": "eds-motion-control-duration", "value": "var(--eds-motion-6)", "comment": "500ms" },
        { "name": "eds-motion-ease-standard", "value": "var(--eds-motion-ease-4)" },
        { "name": "eds-motion-ease-in-out", "value": "var(--eds-motion-ease-standard)" },
        { "name": "eds-hover-transition-duration", "value": "var(--eds-motion-hover-duration)" }
      ]
    }
  ]
}
